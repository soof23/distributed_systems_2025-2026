<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#00E1F3">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

         <LinearLayout
             android:id="@+id/layoutRateContent"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:orientation="vertical"
             android:gravity="center_horizontal"
             android:paddingStart="25dp"
             android:paddingEnd="25dp"
             android:paddingTop="115dp"
             android:paddingBottom="30dp">

             <TextView
                 android:id="@+id/textViewRateTitle"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:fontFamily="@font/determination"
                 android:text="Rate"
                 android:textSize="70sp"
                 android:textColor="#ED773C"
                 android:layout_marginBottom="20dp" />

             <ImageView
                 android:id="@+id/imageViewRateLogo"
                 android:layout_width="340dp"
                 android:layout_height="330dp"
                 android:background="#BDBDBD"
                 android:scaleType="centerCrop"
                 android:src="@drawable/ic_launcher_background"
                 android:contentDescription="Logo" />

             <TextView
                 android:id="@+id/textViewRateGameName"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:fontFamily="@font/typewriter_bold"
                 android:text="Game Name"
                 android:textSize="34sp"
                 android:textColor="#ED773C"
                 android:layout_marginTop="8dp"
                 android:layout_marginBottom="12dp" />

             <LinearLayout
                 android:id="@+id/layoutRate"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:orientation="horizontal"
                 android:gravity="center_vertical"
                 android:layout_marginBottom="12dp">

                 <TextView
                     android:id="@+id/textViewRatingLabel"
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     android:fontFamily="@font/typewriter_bold"
                     android:text="Rating: "
                     android:textSize="36sp"
                     android:textColor="#000000"
                     android:layout_marginEnd="8dp" />

                 <LinearLayout
                     android:id="@+id/layoutRateStars"
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     android:orientation="horizontal"
                     android:gravity="center_vertical" />

                 <TextView
                     android:id="@+id/textViewRating"
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     android:fontFamily="@font/typewriter_bold"
                     android:text="(0.0)"
                     android:textSize="25sp"
                     android:textColor="#000000"
                     android:layout_marginBottom="5dp" />

             </LinearLayout>

             <TextView
                 android:id="@+id/textViewNumberOfVotes"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:fontFamily="@font/typewriter_bold"
                 android:text="Number of Votes: 0"
                 android:textSize="31sp"
                 android:textColor="#000000"
                 android:layout_marginBottom="80dp" />

             <LinearLayout
                 android:id="@+id/layoutMyRating"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:orientation="horizontal"
                 android:gravity="center_vertical"
                 android:layout_marginBottom="70dp">

                 <TextView
                     android:id="@+id/textViewMyRating"
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     android:fontFamily="@font/typewriter_bold"
                     android:text="My Rating: "
                     android:textSize="30sp"
                     android:textColor="#000000"
                     android:layout_marginBottom="10dp" />

                 <EditText
                     android:id="@+id/editTextMyRating"
                     android:layout_width="70dp"
                     android:layout_height="wrap_content"
                     android:inputType="number"
                     android:fontFamily="@font/typewriter_bold"
                     android:hint="1-5"
                     android:textColor="#000000"
                     android:textSize="26sp" />

                 <TextView
                     android:id="@+id/textViewRateStarsW"
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     android:fontFamily="@font/typewriter_bold"
                     android:text="stars"
                     android:textSize="30sp"
                     android:textColor="#000000"
                     android:layout_marginBottom="8dp" />

             </LinearLayout>

             <Button
                 android:id="@+id/buttonSubmitRate"
                 android:layout_width="330dp"
                 android:layout_height="80dp"
                 android:fontFamily="@font/determination"
                 android:text="Submit"
                 android:textSize="26sp"
                 android:textColor="#FFFFFF"
                 android:backgroundTint="#5E17EB" />

             <ProgressBar
                 android:id="@+id/progressBarRate"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:layout_marginTop="25dp"
                 android:visibility="gone" />

         </LinearLayout>

    </ScrollView>

    <ImageButton
        android:id="@+id/buttonHomeRate"
        android:layout_width="56dp"
        android:layout_height="58dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="45dp"
        android:layout_marginTop="38dp"
        android:background="@android:color/transparent"
        android:contentDescription="Main Menu"
        android:padding="0dp"
        android:scaleType="fitCenter"
        android:src="@drawable/home"
        android:visibility="visible" />

    <LinearLayout
        android:id="@+id/layoutTopBalanceRate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="70dp"
        android:layout_marginEnd="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/textViewTopBalanceRate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/determination"
            android:text="0 FUN"
            android:textSize="30sp"
            android:textColor="#000000"
            android:layout_marginEnd="6dp" />

        <ImageView
            android:id="@+id/imageViewCoinRate"
            android:layout_width="45dp"
            android:layout_height="40dp"
            android:src="@drawable/coin"
            android:contentDescription="Coin"/>
    </LinearLayout>

</FrameLayout>