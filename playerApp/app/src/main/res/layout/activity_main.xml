<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center"
    android:background="#00E1F3">

    <TextView
        android:id="@+id/textViewHello"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hello"
        android:textColor="#ED773C"
        android:textSize="70sp"
        android:fontFamily="@font/determination"
        android:layout_marginBottom="30dp"/>

    <EditText
        android:id="@+id/editTextPlayerId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/typewriter_bold"
        android:hint="Enter Player ID"
        android:inputType="text"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/buttonLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/determination"
        android:text="Login"
        android:textColor="#FFFFFF"
        android:backgroundTint="#5E17EB"/>

    <ProgressBar
        android:id="@+id/progressBarLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:visibility="gone" />

</LinearLayout>